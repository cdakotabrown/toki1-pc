+// ---- tokimeki-pc patch: the enhanced interpolators ------------------------
+// Sinc: 8 taps (s-7 .. s) around s-4 + frac, i.e. two samples after the
+// Gaussian's point, Kaiser window (beta 6), normalised to unity gain per
+// phase.  The cutoff follows the pitch so a voice played above its rate is
+// band-limited before it is resampled: 0.9 x Nyquist / the bucket's top
+// ratio.  Tables are built once, deterministically (double precision,
+// rounded to Q15), the first time the mode is chosen.
+namespace SPU {
+enum : u32
+{
+  PC_SINC_BUCKETS = 7,
+  PC_SINC_TAPS = 8
+};
+static const double s_pc_sinc_top[PC_SINC_BUCKETS] = {1.0, 1.25, 1.6, 2.0, 2.5, 3.2, 4.0};
+static s32 s_pc_sinc[PC_SINC_BUCKETS][256][PC_SINC_TAPS];
+static bool s_pc_sinc_ready;
+
+static double PcBesselI0(double x)
+{
+  double sum = 1.0, term = 1.0;
+  for (int k = 1; k < 40; k++)
+  {
+    term *= (x / (2.0 * k)) * (x / (2.0 * k));
+    sum += term;
+  }
+  return sum;
+}
+
+static void PcBuildSinc()
+{
+  static constexpr double PI = 3.14159265358979323846, BETA = 6.0;
+  if (s_pc_sinc_ready)
+    return;
+  const double i0b = PcBesselI0(BETA);
+  for (u32 b = 0; b < PC_SINC_BUCKETS; b++)
+  {
+    const double c = 0.9 / s_pc_sinc_top[b];
+    for (u32 p = 0; p < 256; p++)
+    {
+      double h[PC_SINC_TAPS], sum = 0.0;
+      for (u32 k = 0; k < PC_SINC_TAPS; k++)
+      {
+        const double d = double(k) - 3.0 - double(p) / 256.0;
+        const double r = d / 4.0;
+        const double w = (r <= -1.0 || r >= 1.0) ? 0.0 : PcBesselI0(BETA * std::sqrt(1.0 - r * r)) / i0b;
+        const double x = PI * c * d;
+        h[k] = c * (d == 0.0 ? 1.0 : std::sin(x) / x) * w;
+        sum += h[k];
+      }
+      s32 acc = 0;
+      for (u32 k = 0; k < PC_SINC_TAPS; k++)
+      {
+        s_pc_sinc[b][p][k] = static_cast<s32>(std::floor(h[k] / sum * 32768.0 + 0.5));
+        acc += s_pc_sinc[b][p][k];
+      }
+      s_pc_sinc[b][p][3] += 32768 - acc;   // exact unity gain after rounding
+    }
+  }
+  s_pc_sinc_ready = true;
+}
+} // namespace SPU
+
+extern "C" void ds_spu_prepare_quality(int interp)
+{
+  if (interp == 2)
+    SPU::PcBuildSinc();
+}
+
+s32 SPU::PcInterpolate(const Voice& v)
+{
+  const u32 i = v.counter.interpolation_index;
+  const s32 s = s32(NUM_SAMPLES_FROM_LAST_ADPCM_BLOCK) + s32(v.counter.sample_index.GetValue());
+  if (s_pc_quality.interp == 1 || !s_pc_sinc_ready)
+  {
+    // Catmull-Rom through s-3 .. s at s-2 + i/256
+    const s32 p0 = v.current_block_samples[s - 3], p1 = v.current_block_samples[s - 2];
+    const s32 p2 = v.current_block_samples[s - 1], p3 = v.current_block_samples[s];
+    const s32 f = s32(i);
+    const s32 a = 3 * (p1 - p2) + p3 - p0;
+    const s32 b = 2 * p0 - 5 * p1 + 4 * p2 - p3;
+    const s32 c = p2 - p0;
+    const s64 x = ((((((s64(a) * f) >> 8) + b) * f) >> 8) + c) * f;
+    return Clamp16(p1 + s32(x >> 9));
+  }
+  const s16* hist = s_pc_hist[&v - s_state.voices.data()];
+  const u32 step = v.regs.adpcm_sample_rate;
+  u32 b = 0;
+  while (b + 1 < PC_SINC_BUCKETS && double(step) > s_pc_sinc_top[b] * 4096.0)
+    b++;
+  const s32* h = s_pc_sinc[b][i];
+  s64 acc = 0;
+  for (s32 k = 0; k < s32(PC_SINC_TAPS); k++)
+  {
+    const s32 idx = s - 7 + k;
+    acc += s64(h[k]) * (idx >= 0 ? v.current_block_samples[idx] : hist[idx + 5]);
+  }
+  return Clamp16(s32((acc + 0x4000) >> 15));
+}
