+// ---- tokimeki-pc patch: the floating-point reverb unit ---------------------
+// ProcessReverb below, statement for statement, in float: the same
+// registers, work-area addresses (its own float copy of the area), 39-tap
+// half-band resamplers and 22.05 kHz processing, without the 16-bit storage,
+// the Clamp16 at every stage and the truncating shifts.  Its input is what
+// the output's reverb would get; it starts from silence when turned on or
+// when the game moves the work area (mBASE).
+namespace SPU {
+static u32 PcHqAddr(u32 address)
+{
+  static constexpr u32 MASK = (RAM_SIZE - 1) / 2;
+  u32 offset = s_pc_quality.hq.current_address + (address & MASK);
+  offset += s_state.reverb_base_address & ((s32)(offset << 13) >> 31);
+  return offset & MASK;
+}
+} // namespace SPU
+
+void SPU::PcProcessReverbHQ(float left_in, float right_in, float* left_out, float* right_out)
+{
+  static constexpr float h39[39] = {
+    -1.0f, 0.0f, 2.0f, 0.0f, -10.0f, 0.0f, 35.0f, 0.0f, -103.0f, 0.0f, 266.0f, 0.0f, -616.0f, 0.0f,
+    1332.0f, 0.0f, -2960.0f, 0.0f, 10246.0f, 16384.0f, 10246.0f, 0.0f, -2960.0f, 0.0f, 1332.0f, 0.0f,
+    -616.0f, 0.0f, 266.0f, 0.0f, -103.0f, 0.0f, 35.0f, 0.0f, -10.0f, 0.0f, 2.0f, 0.0f, -1.0f};
+  static constexpr float h20[20] = {-1.0f,    2.0f,     -10.0f,  35.0f,   -103.0f, 266.0f,  -616.0f,
+                                    1332.0f,  -2960.0f, 10246.0f, 10246.0f, -2960.0f, 1332.0f, -616.0f,
+                                    266.0f,   -103.0f,  35.0f,   -10.0f,  2.0f,    -1.0f};
+  PcHqReverb& q = s_pc_quality.hq;
+  const ReverbRegisters& R = s_state.reverb_registers;
+  if (!q.primed || q.ram == nullptr || q.base != s_state.reverb_base_address)
+  {
+    if (q.ram)
+      std::fill_n(q.ram, RAM_SIZE / 2, 0.0f);
+    for (auto& a : q.downsample)
+      a.fill(0.0f);
+    for (auto& a : q.upsample)
+      a.fill(0.0f);
+    q.position = 0;
+    q.current_address = q.base = s_state.reverb_base_address;
+    q.primed = q.ram != nullptr;
+    if (!q.primed)
+    {
+      *left_out = *right_out = 0.0f;
+      return;
+    }
+  }
+  auto rd = [&](u32 address, s32 offset = 0) { return q.ram[PcHqAddr((address << 2) + offset)]; };
+  auto wr = [&](u32 address, float v) { q.ram[PcHqAddr(address << 2)] = v; };
+  const auto iiasm = [&](float x) {
+    return R.IIR_ALPHA == -32768 ? x * -65536.0f : x * float(32768 - R.IIR_ALPHA);
+  };
+  const auto neg = [](s32 v) { return float(v == -32768 ? 0x7FFF : -v); };
+
+  q.downsample[0][q.position | 0x00] = q.downsample[0][q.position | 0x40] = left_in;
+  q.downsample[1][q.position | 0x00] = q.downsample[1][q.position | 0x40] = right_in;
+
+  float out[2];
+  if (q.position & 1u)
+  {
+    float down[2];
+    for (u32 ch = 0; ch < 2; ch++)
+    {
+      const float* src = &q.downsample[ch][(q.position - 38) & 0x3F];
+      float acc = 0.0f;
+      for (u32 k = 0; k < 39; k++)
+        acc += h39[k] * src[k];
+      down[ch] = acc / 32768.0f;
+    }
+    for (u32 ch = 0; ch < 2; ch++)
+    {
+      if (s_state.SPUCNT.reverb_master_enable)
+      {
+        const float in_a = ((rd(R.IIR_SRC_A[ch ^ 0]) * R.IIR_COEF) / 16384.0f +
+                            (down[ch] * R.IN_COEF[ch]) / 16384.0f) * 0.5f;
+        const float in_b = ((rd(R.IIR_SRC_B[ch ^ 1]) * R.IIR_COEF) / 16384.0f +
+                            (down[ch] * R.IN_COEF[ch]) / 16384.0f) * 0.5f;
+        const float iir_a = ((in_a * R.IIR_ALPHA) / 16384.0f + iiasm(rd(R.IIR_DEST_A[ch], -1)) / 16384.0f) * 0.5f;
+        const float iir_b = ((in_b * R.IIR_ALPHA) / 16384.0f + iiasm(rd(R.IIR_DEST_B[ch], -1)) / 16384.0f) * 0.5f;
+        wr(R.IIR_DEST_A[ch], iir_a);
+        wr(R.IIR_DEST_B[ch], iir_b);
+      }
+      const float acc = (rd(R.ACC_SRC_A[ch]) * R.ACC_COEF_A) / 16384.0f +
+                        (rd(R.ACC_SRC_B[ch]) * R.ACC_COEF_B) / 16384.0f +
+                        (rd(R.ACC_SRC_C[ch]) * R.ACC_COEF_C) / 16384.0f +
+                        (rd(R.ACC_SRC_D[ch]) * R.ACC_COEF_D) / 16384.0f;
+      const float fb_a = rd(R.MIX_DEST_A[ch] - R.FB_SRC_A);
+      const float fb_b = rd(R.MIX_DEST_B[ch] - R.FB_SRC_B);
+      const float mda = (acc + (fb_a * neg(R.FB_ALPHA)) / 16384.0f) * 0.5f;
+      const float mdb = fb_a + (((mda * R.FB_ALPHA) / 16384.0f) + ((fb_b * neg(R.FB_X)) / 16384.0f)) * 0.5f;
+      q.upsample[ch][(q.position >> 1) | 0x20] = q.upsample[ch][q.position >> 1] = fb_b + (mdb * R.FB_X) / 32768.0f;
+      if (s_state.SPUCNT.reverb_master_enable)
+      {
+        wr(R.MIX_DEST_A[ch], mda);
+        wr(R.MIX_DEST_B[ch], mdb);
+      }
+    }
+    q.current_address = (q.current_address + 1) & 0x3FFFFu;
+    q.current_address = (q.current_address == 0) ? s_state.reverb_base_address : q.current_address;
+    for (u32 ch = 0; ch < 2; ch++)
+    {
+      const float* src = &q.upsample[ch][((q.position >> 1) - 19) & 0x1F];
+      float acc = 0.0f;
+      for (u32 k = 0; k < 20; k++)
+        acc += h20[k] * src[k];
+      out[ch] = acc / 16384.0f;
+    }
+  }
+  else
+  {
+    const u32 idx = (((q.position >> 1) - 19) & 0x1F) + 9;
+    out[0] = q.upsample[0][idx];
+    out[1] = q.upsample[1][idx];
+  }
+  q.position = (q.position + 1) & 0x3F;
+  *left_out = out[0] * R.vLOUT / 32768.0f;
+  *right_out = out[1] * R.vROUT / 32768.0f;
+}
