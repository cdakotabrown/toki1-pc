0002 music split (music packs, 2026-11-02): ds_spu_music_split /
ds_spu_mix_split and the shadow reverb unit.  This project's own change;
described in pc/3rd/SPU-CORE.md "Local patches".

--- a/upstream/spu.cpp
+++ b/upstream/spu.cpp
@@ -428,8 +428,81 @@
 ALIGN_TO_CACHE_LINE static SPUState s_state;
 ALIGN_TO_CACHE_LINE static std::array<u8, RAM_SIZE> s_ram{};
 
+// ---- tokimeki-pc patch: the music split (README.md "PC patches") ----------
+// The PC port's music packs (pc/hal/music_pack.c) silence the voices that
+// play the sequenced music and stream a replacement instead.  The split
+// changes NOTHING in the device: every voice is still sampled, the capture
+// buffers, ENDX, ADSR and the real reverb unit (its state and its work area
+// in s_ram) run exactly as before.  A second "rest" mix leaves the masked
+// voices out of the dry sum and feeds a shadow reverb unit (its own copy of
+// the work area and resampling buffers); `replace` sends the rest mix to the
+// output instead of the full one.  `music` (when given) receives the music's
+// own share, full minus rest, before the main volume.  With the split off
+// none of this runs and the output is the unpatched computation.
+struct PcShadowReverb
+{
+  std::array<std::array<s16, 128>, 2> downsample;
+  std::array<std::array<s16, 64>, 2> upsample;
+  s32 position;
+  u32 current_address;
+  s16 last_input[2];
+  s32 last_output[2];
+};
+struct PcSplit
+{
+  bool on;
+  bool replace;
+  u32 mask;
+  s16* music;           // the current GenerateSamples call's music-only frames, or null
+  u8* reverb_ram;       // null: s_ram; else the shadow work area (during the rest pass)
+  u8* shadow_ram;       // RAM_SIZE bytes, allocated on first use, never freed
+  PcShadowReverb shadow;
+};
+static PcSplit s_pc_split;
+static void PcSwapShadowReverb();
+
 } // namespace SPU
 
+extern "C" void ds_spu_music_split(int on, u32 voice_mask, int replace)
+{
+  using namespace SPU;
+  if (on && !s_pc_split.on)
+  {
+    if (!s_pc_split.shadow_ram)
+      s_pc_split.shadow_ram = new u8[RAM_SIZE];
+    std::memcpy(s_pc_split.shadow_ram, s_ram.data(), RAM_SIZE);
+    s_pc_split.shadow.downsample = s_state.reverb_downsample_buffer;
+    s_pc_split.shadow.upsample = s_state.reverb_upsample_buffer;
+    s_pc_split.shadow.position = s_state.reverb_resample_buffer_position;
+    s_pc_split.shadow.current_address = s_state.reverb_current_address;
+    s_pc_split.shadow.last_input[0] = s_state.last_reverb_input[0];
+    s_pc_split.shadow.last_input[1] = s_state.last_reverb_input[1];
+    s_pc_split.shadow.last_output[0] = s_state.last_reverb_output[0];
+    s_pc_split.shadow.last_output[1] = s_state.last_reverb_output[1];
+  }
+  s_pc_split.on = on != 0;
+  s_pc_split.mask = on ? voice_mask : 0u;
+  s_pc_split.replace = on && replace;
+}
+
+extern "C" void ds_spu_music_capture(s16* music_frames)
+{
+  SPU::s_pc_split.music = music_frames;
+}
+
+void SPU::PcSwapShadowReverb()
+{
+  std::swap(s_pc_split.shadow.downsample, s_state.reverb_downsample_buffer);
+  std::swap(s_pc_split.shadow.upsample, s_state.reverb_upsample_buffer);
+  std::swap(s_pc_split.shadow.position, s_state.reverb_resample_buffer_position);
+  std::swap(s_pc_split.shadow.current_address, s_state.reverb_current_address);
+  std::swap(s_pc_split.shadow.last_input[0], s_state.last_reverb_input[0]);
+  std::swap(s_pc_split.shadow.last_input[1], s_state.last_reverb_input[1]);
+  std::swap(s_pc_split.shadow.last_output[0], s_state.last_reverb_output[0]);
+  std::swap(s_pc_split.shadow.last_output[1], s_state.last_reverb_output[1]);
+}
+// ---- end of the tokimeki-pc patch declarations -----------------------------
