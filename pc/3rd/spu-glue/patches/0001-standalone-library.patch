+}
+
+// Standalone-library extension: directly synthesize N output frames.
+// We feed SPU::Execute enough CPU ticks for exactly num_frames of output
+// (plus any carry left over from last call). Clears ticks_carry first so the
+// math lines up, then restores a zero carry afterward — callers who mix this
+// with the real tick_event will experience at most 1-frame rounding error.
+void SPU::GenerateSamples(u32 num_frames)
+{
+  if (num_frames == 0)
+    return;
+
+  // Make sure any transfer work pending on the FIFO lands in RAM before we
+  // start synthesizing — matches what GeneratePendingSamples does.
+  if (s_state.transfer_event.IsActive())
+    s_state.transfer_event.InvokeEarly();
+
+  // Execute() consumes (ticks + ticks_carry) CPU ticks. To produce exactly
+  // num_frames SPU frames, hand it num_frames * SYSCLK_TICKS_PER_SPU_TICK
+  // CPU ticks and reset the carry so no rounding error sneaks in.
+  s_state.ticks_carry = 0;
+  const TickCount ticks = static_cast<TickCount>(num_frames) *
+                          static_cast<TickCount>(SYSCLK_TICKS_PER_SPU_TICK);
+  SPU::Execute(nullptr, ticks, 0);
+}
